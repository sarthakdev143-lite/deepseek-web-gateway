{
  "name": "deepseek-web-gateway",
  "version": "1.0.0",
  "description": "Local HTTP server that drives the free DeepSeek web chat UI via Playwright and runs an agent tool-calling loop. No API key required.",
  "main": "src/index.js",
  "license": "MIT",
  "author": "Sarthak Parulekar",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarthakdev143-lite/deepseek-web-gateway.git"
  },
  "keywords": [
    "deepseek",
    "ai-agent",
    "playwright",
    "code-agent",
    "llm",
    "tool-calling"
  ],
  "scripts": {
    "start": "node src/server.js",
    "start:server": "node src/server.js",
    "start:cli": "node src/index.js",
    "test": "node test/run-all.js",
    "logs": "node src/view-logs.js",
    "logs:last": "node src/view-logs.js --last",
    "logs:summary": "node src/view-logs.js --last --summary"
  },
  "dependencies": {
    "express": "^5.2.1",
    "playwright": "^1.60.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ]
}
